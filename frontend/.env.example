# Fixture mode: the app imports contracts/fixtures/*.json directly and simulates
# network latency. This is the default and requires no backend.
VITE_USE_FIXTURES=true

# Live mode: set the above to false. Requests go to VITE_API_BASE.
# Leave VITE_API_BASE as /api/v1 to use the Vite dev proxy -> http://localhost:8000
VITE_API_BASE=/api/v1

# Simulated round-trip latency in fixture mode (ms). Set to 0 for instant.
VITE_FIXTURE_LATENCY_MS=420
