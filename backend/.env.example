# Smart Market Watchlist — backend configuration
#
# EVERY VARIABLE IN THIS FILE IS OPTIONAL.
# Copy to .env only if you want to change a default. With no .env at all the
# app runs on SQLite + an in-process cache + the deterministic template
# summariser, which is a complete, honest demo.

# ---------------------------------------------------------------------------
# LLM providers — OPTIONAL. Free tiers only.
# With neither key set, llm/router.py cascades straight to the deterministic
# template summariser and GET /health reports both providers as unconfigured.
# Nothing in the product breaks; summaries just stop being LLM-written.
# ---------------------------------------------------------------------------

# Google AI Studio -> https://aistudio.google.com/apikey  (free tier)
# Model: gemini-2.5-flash. Free tier is roughly 10 RPM / 250-1500 RPD and
# Google changes it without notice, so the router treats the live 429/quota
# metadata as authoritative and only uses the number below as a cold start.
# GEMINI_API_KEY=

# OpenRouter -> https://openrouter.ai/keys  (free tier, no credit card)
# Only model ids ending in ":free" are ever requested.
# Free accounts: 20 RPM, 50 RPD.
# OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Datastores — OPTIONAL, both have zero-setup fallbacks.
# ---------------------------------------------------------------------------

# Unset      -> sqlite+aiosqlite:///./watchlist.db  (created automatically)
# docker compose up -d  ->  the URL below
# If a Postgres URL is set but unreachable, the app logs a warning and falls
# back to SQLite rather than refusing to boot.
# DATABASE_URL=postgresql+asyncpg://watchlist:watchlist@localhost:5432/watchlist

# Unset or unreachable -> in-process dict shim with the same interface.
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Feed
# ---------------------------------------------------------------------------
# "simulator" (default) — deterministic seeded replay, the demo centrepiece.
# "yahoo"               — real NSE quotes via Yahoo Finance (RELIANCE.NS style).
#                         Falls back to the simulator for history and whenever
#                         the network is unavailable.
FEED_ADAPTER=simulator

# ---------------------------------------------------------------------------
# Product knobs
# ---------------------------------------------------------------------------
ATTENTION_CAP=5              # max items per digest (the attention budget)
MIN_CONFIRMATIONS=2          # the two-factor gate. Do not set below 2.
CROWD_MIN_COHORT=500         # k-anonymity floor for CROWD_FLOW
SUSPECT_DISAGREEMENT_PCT=1.0 # source disagreement above this => SUSPECT
